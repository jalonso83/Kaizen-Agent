# ─── Kaizen · variables de entorno ──────────────────────────────────────
# Copia este archivo a .env y completa los valores (los entrega FinZen).
# NUNCA commitees el .env real.

# Puerto del server (local)
PORT=4000

# ── FinZen Agent API ──
FINZEN_API_URL=https://finzenai-backend-production.up.railway.app
# Opcional en dev: sin esto el server arranca igual y la web se puede ver;
# las tools que llaman a FinZen (get_kpis, evaluate_segment, ...) van a fallar
# con 401 recién cuando de verdad se usen. Requerida para producción.
FINZEN_AGENT_KEY=

# ── Anthropic / Claude ──
# Opcional en dev: sin esto el server arranca y la web/login funcionan, pero
# mandar un mensaje de chat da un error claro ("falta la key de Anthropic")
# en vez de una respuesta real. Requerida para producción.
ANTHROPIC_API_KEY=

# ── Indexado del Cerebro ──
# Lectura de imágenes: las imágenes del Cerebro (.png/.jpg/.webp/.gif) se
# describen con visión y se indexa esa descripción, así un storyboard o un
# pantallazo de un panel dejan de ser invisibles. Encendido por defecto.
# Ponlo en "false" para apagarlo: el costo es de UNA llamada por imagen y por
# versión del archivo (el indexador solo re-lee lo que cambió), no por corrida.
CEREBRO_VISION_ENABLED=
# Modelo para describir imágenes. Por defecto el mismo del agente
# (claude-opus-4-8). claude-haiku-4-5 es la opción barata si hubiera muchas.
CEREBRO_VISION_MODEL=

# ── Google Drive · Cerebro y Contenidos (Fase 1) ──
# Credenciales de la Service Account — usa UNA de las dos opciones:
#  - Local: ruta al JSON descargado (el archivo NO se commitea)
#  - Railway: el contenido del JSON codificado en base64
# ESCRITURA: OAuth de usuario. Es la ÚNICA vía que permite crear archivos.
# Una service account NO puede crear en un Drive personal (no tiene cuota de
# almacenamiento); Google responde "Service Accounts do not have storage quota".
# Las alternativas oficiales (unidad compartida, delegación de dominio) requieren
# Google Workspace, que no tenemos.
# El refresh token se saca UNA vez con: npm run drive:auth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# LECTURA (respaldo): service account. Leer el Cerebro le funciona bien.
GOOGLE_SERVICE_ACCOUNT_PATH=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

DRIVE_CEREBRO_FOLDER_ID=
DRIVE_CONTENIDOS_FOLDER_ID=
# OPCIONAL. La carpeta 50-kaizen/ se busca por nombre dentro del Cerebro, así
# que normalmente no hace falta. Solo sirve como atajo para ahorrar esa búsqueda.
DRIVE_KAIZEN_FOLDER_ID=

# ── Base de datos propia de Kaizen (requerida: conversaciones, propuestas, audit log) ──
# Postgres. Local recomendado vía Docker o server/prisma/local/setup_mysql.sql
# como alternativa (ver server/prisma/local/README.md para las salvedades).
DATABASE_URL=

# ── Auth del chat de socios (requerida) ──
# Cualquier string largo y aleatorio; nunca lo reutilices de otro proyecto.
JWT_SECRET=

# ── Guardarraíl de campañas (opcional, default 5) ──
KAIZEN_MAX_DRAFTS_PER_DAY=5

# ── Kill switch propio: false = el agente no corre ──
AGENT_ENABLED=true

# ── Cookie de sesión Secure en producción (Railway u otro no siempre lo setea
#    solo) — sin esto en "production", la cookie del login no lleva Secure. ──
NODE_ENV=development

# ── Solo para `npm run chat` (scripts/chatCli.ts), no la usa el server. ──
# A qué Kaizen le habla el cliente de consola. Default: http://localhost:4000
KAIZEN_BASE_URL=

# ── Meta Marketing API (Fase 2) ──
# El token y la cuenta los entrega FinZen. NUNCA los pegues en un chat ni los
# commitees: un System User Token da acceso al Business Manager entero.
#
# Arrancamos en SOLO LECTURA: el token debe tener ads_read y nada más. El PRD
# §2.1 pide ≥1 semana de lecturas estables antes de pedir ads_management.
META_SYSTEM_TOKEN=
META_AD_ACCOUNT_ID=

# Tope de gasto diario por campaña, en USD. Si la cuenta factura en otra
# moneda, el cliente RECHAZA en vez de convertir con un tipo de cambio que
# nadie revisó — hay que redefinir el tope en la moneda de la cuenta.
META_MAX_DAILY_BUDGET_USD=20

# Interruptor de escritura. En false (default) no sale ni un POST hacia Meta,
# aunque el token tuviera permiso. Se activa a mano recién cuando la lectura
# lleve una semana estable.
META_WRITE_ENABLED=false

# Solo para desarrollo: permite apuntar el cliente a otro host (por ejemplo un
# simulador local de la Graph API). En producción se deja vacío y usa
# https://graph.facebook.com/v21.0
META_API_BASE_URL=

# ── Instagram (misma Graph API, MISMO token) ──
# No hay credencial aparte: Instagram usa META_SYSTEM_TOKEN, con dos permisos
# más — instagram_basic y pages_read_engagement. Para los insights de la
# cuenta propia (alcance, guardados, taps al link; el Dashboard y la tool los
# muestran si llegan) hace falta además instagram_manage_insights. Sin ese
# permiso todo lo demás funciona y el bloque de insights dice por qué falta.
#
# El id del nodo de Instagram de FinZen. Hace falta incluso para leer un perfil
# ajeno: la consulta business_discovery se hace SOBRE la cuenta propia y pide
# el perfil de otro como campo. Requisitos de la cuenta: tiene que ser Business
# o Creator y estar vinculada a una página de Facebook.
#
# Cómo obtenerlo:  GET /{page-id}?fields=instagram_business_account
INSTAGRAM_ACCOUNT_ID=

# ── TikTok (Display API v2) — solo la cuenta PROPIA de FinZen ──
# TikTok no tiene un equivalente a business_discovery: por su API solo se lee
# la cuenta que autorizó la app (Login Kit, scopes user.info.basic,
# user.info.profile, user.info.stats, video.list). Los competidores se pueden
# guardar en Marketing → Configuración como referencia, pero no se leen.
#
# Cómo se obtiene: app en developers.tiktok.com → Login Kit → autorizar con la
# cuenta de FinZen → el refresh token del intercambio. El access token dura 24h
# y Kaizen lo renueva solo; el refresh dura 365 días y TikTok lo puede ROTAR,
# así que el vigente se guarda en la BD (TiktokCredential) y esta variable
# solo siembra el primero. Nunca por chat: directo a Railway.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# Solo desarrollo: apuntar al simulador (npm run mock:tiktok).
TIKTOK_API_BASE_URL=
