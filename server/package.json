{
  "name": "kaizen-server",
  "version": "0.1.0",
  "private": true,
  "description": "Kaizen — orquestador del agente de crecimiento de FinZen AI",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "check": "tsx src/check.ts",
    "build": "npm --prefix ../web install && npm --prefix ../web run build && node scripts/copyWebDist.mjs && prisma generate && tsc",
    "build:server-only": "prisma generate && tsc",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/tests/*.test.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed:partner": "tsx src/scripts/seedPartners.ts",
    "chat": "tsx src/scripts/chatCli.ts",
    "drive:auth": "tsx src/scripts/driveAuth.ts",
    "mock:finzen": "tsx src/mock/finzenApiMock.ts",
    "mock:graph": "tsx src/mock/graphApiMock.ts",
    "mock:tiktok": "tsx src/mock/tiktokApiMock.ts",
    "test:graph": "tsx src/scripts/testGraph.ts",
    "test:tiktok": "tsx src/scripts/testTiktok.ts",
    "test:tools": "tsx src/scripts/testTools.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "node-cron": "^4.6.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
