// Esquema de la base de datos de Kaizen (Fase 1) — DISENO_FASE1.md §1.
// Postgres en Railway (SQLite pierde datos en cada redeploy; el audit log debe ser durable).
// El blindaje del audit log (trigger append-only) y el índice FTS del Cerebro
// se aplican por SQL crudo: ver prisma/manual.sql (correr DESPUÉS de migrate).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Partner {
  // Socios de FinZen. Seed manual (2-3 filas) — sin registro público.
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String // bcrypt cost 12
  // 'ADMIN' | 'ASSISTANT' | 'USER' — ver src/auth/permisos.ts, que es la tabla
  // de qué puede hacer cada uno. Se guarda el rol, NO los permisos: así cambiar
  // qué incluye un rol no obliga a migrar filas.
  // Sin enum de Prisma a propósito: agregar un valor a un enum de Postgres pide
  // migración, y estos roles van a moverse mientras el equipo crece.
  role          String         @default("USER")
  disabled      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  // Quién lo creó, para la auditoría. Null en los socios sembrados por CLI.
  createdBy     String?
  conversations Conversation[]
}

model Conversation {
  id             String       @id @default(cuid())
  partnerId      String
  partner        Partner      @relation(fields: [partnerId], references: [id])
  title          String       @default("Nueva conversación")
  summary        String? // resumen rodante para compactación (§5); null hasta que haga falta
  summaryUpToSeq Int? // hasta qué seq cubre el resumen
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  messages       Message[]
  proposals      Proposal[]
  goals          Goal[]
  adProposals    AdProposal[]

  @@index([partnerId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  seq            Int // orden estricto dentro de la conversación
  role           String // 'user' | 'assistant'
  content        Json // array de content blocks de la API de Anthropic TAL CUAL
  inputTokens    Int? // usage de la corrida (solo en assistant)
  outputTokens   Int?
  stopReason     String? // end_turn | max_tokens | refusal | ...
  createdAt      DateTime     @default(now())

  @@unique([conversationId, seq])
}

model Proposal {
  id                  String       @id @default(cuid())
  conversationId      String
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status              String       @default("PROPOSED")
  // PROPOSED → CONFIRMED → EXECUTING → EXECUTED
  //          ↘ REJECTED (botón Rechazar) · SUPERSEDED (propuesta más nueva en la conversación)
  //            EXECUTING → UNKNOWN_OUTCOME (fallo a mitad del POST — requiere verificación humana)
  payload             Json // CampaignDraftInput COMPLETO al momento de proponer — la única fuente de verdad
  segmentCount        Int? // count real al proponer, para la tarjeta
  expectedMeasurement String? // qué se va a medir y cómo (DISENO §6) — no viaja a FinZen, solo para la tarjeta/auditoría
  messageType         String? // taxonomía de tipo de mensaje (2026-07-24): urgencia|educativo|incentivo|social_proof|pregunta_directa|otro — no viaja a FinZen, es para que get_message_type_performance agregue lift por tipo
  finzenCampaignId    String?
  confirmedAt         DateTime?
  confirmedBy         String? // partnerId — SOLO lo escribe el endpoint HTTP, jamás el agente
  executedAt          DateTime?
  error               String?
  // Bajo qué meta nació esta campaña. Se graba al proponer, desde la meta
  // ACTIVE del momento — no se deduce después por fechas, porque una meta
  // puede cambiar entre que se propone y que se ejecuta. Null en las
  // propuestas anteriores a que existieran las metas: eso es un dato, no un
  // hueco, y la pantalla lo dice tal cual.
  goalId              String?
  goal                Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  // De dónde salió: 'chat' (Kaizen la propuso en una conversación con el socio)
  // o 'diaria' (la corrida automática de campaña diaria, 2026-09-20). Sirve
  // para la rotación de audiencias: el job no repite un segmento que una
  // campaña diaria ya usó en la última semana.
  origen              String       @default("chat")
  createdAt           DateTime     @default(now())

  @@index([conversationId, status])
  @@index([goalId])
}

model Goal {
  // La meta vigente del negocio: qué métrica se persigue y con qué número.
  // Mismo principio que Proposal (DISENO §7): el estado ACTIVE lo escribe SOLO
  // el endpoint HTTP del botón, nunca el agente. Kaizen puede *proponer* una
  // meta o su cambio, pero no puede activarla ni reemplazarla por su cuenta.
  id             String        @id @default(cuid())
  conversationId String? // dónde se propuso, para pintar la tarjeta
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  metric         String // identificador corto, ej. 'lift_pts'
  metricLabel    String // cómo se lee, ej. "lift en tasa de transacción vs holdout"
  target         Float // meta numérica
  unit           String // 'pts' | '%' | 'usuarios' | 'usd' | ...
  // 'gte' = se logra al alcanzar o superar el target; 'lte' = al bajar de él
  // (para métricas donde menos es mejor, como churn o CAC).
  direction      String        @default("gte")
  rationale      String
  status         String        @default("PROPOSED")
  // PROPOSED → ACTIVE → ACHIEVED
  //          ↘ REJECTED (botón Rechazar) · SUPERSEDED (la reemplazó otra meta confirmada)
  confirmedAt    DateTime?
  confirmedBy    String? // partnerId — SOLO lo escribe el endpoint HTTP
  achievedAt     DateTime?
  achievedValue  Float? // valor medido con el que se dio por lograda
  achievedNote   String? // de dónde salió ese valor (campaña, tool)
  // Si esta meta nace para reemplazar a otra, cuál. Permite mostrar el
  // "antes → después" en la tarjeta de confirmación.
  replacesGoalId String?
  createdAt      DateTime      @default(now())
  // Las campañas que se propusieron persiguiendo esta meta. Es la evidencia de
  // si la meta guió algo o quedó de adorno.
  proposals      Proposal[]

  @@index([status, createdAt])
}

model AuditLog {
  // INMUTABLE: solo INSERT (un trigger de Postgres aborta UPDATE/DELETE — ver manual.sql).
  id             BigInt   @id @default(autoincrement())
  conversationId String?
  actor          String // 'agent' | 'partner:<id>' | 'cron' | 'system'
  action         String // 'tool:get_kpis' | 'proposal:confirmed' | 'login' | 'gate:denied' | ...
  input          Json?
  resultSummary  String? // resultado truncado a 2000 chars
  isError        Boolean  @default(false)
  durationMs     Int?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
}

model CerebroDoc {
  id           String   @id // fileId de Drive
  name         String
  path         String // ej. "10-decisiones/pricing"
  mimeType     String
  text         String // texto plano exportado (truncado a ~200KB)
  modifiedTime String // el de Drive — para re-descargar solo cambios
  indexedAt    DateTime @default(now())
  // + columna tsv (tsvector) añadida por SQL manual — ver prisma/manual.sql
}

model MarketingAccount {
  // Un perfil social que Kaizen puede leer, guardado desde el apartado de
  // Marketing (2026-09-10).
  //
  // UNA FILA POR PERFIL, y no una columna por red en una fila única de
  // configuración. El motivo: la lista crece en dos direcciones —competidores
  // de la misma red, y redes nuevas (TikTok, YouTube)— y con columnas cada una
  // de esas dos cosas necesitaría una migración. Acá no necesita ninguna.
  id        String   @id @default(cuid())
  // 'INSTAGRAM' por ahora. Texto y no enum de Postgres: agregar un valor a un
  // enum es una migración, y este campo va a crecer.
  red       String
  // El handle, SIN arroba y en minúsculas — derivado de la URL con
  // util/instagram.ts. Es lo que la Graph API pide; la URL es lo que la persona
  // tiene a mano. Se guardan los dos: la URL para mostrar y abrir, el usuario
  // para consultar.
  usuario   String
  url       String
  // Cómo llamarlo en pantalla ("FinZen", "Competidor X"). Opcional: si falta,
  // la interfaz muestra el @usuario.
  etiqueta  String?
  // ¿Es la cuenta de FinZen o la de un tercero? No es cosmético: de la propia
  // se pueden obtener alcance y guardados (con instagram_manage_insights); de
  // un tercero, jamás. Sin esta marca, el agente no puede saber qué métricas
  // tiene derecho a esperar de cada fila.
  //
  // Debería haber UNA sola propia por red. No se puede expresar como
  // restricción de Postgres (haría falta un índice único parcial, que Prisma no
  // declara), así que la garantiza la ruta dentro de una transacción.
  esPropia  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // partnerId de quien la agregó

  // El mismo perfil no se guarda dos veces. Sobre el USUARIO y no sobre la
  // URL: instagram.com/finzenai y instagram.com/FinZenAI/?hl=es son el mismo
  // perfil con dos URLs distintas, y la que se compara tiene que ser la forma
  // normalizada.
  @@unique([red, usuario])
  @@index([red, esPropia])
}

model InstagramSnapshot {
  // Una lectura por día de un perfil de Instagram (2026-09-12). Es lo que le
  // da HISTÓRICO al Dashboard y a Kaizen: la Graph API devuelve solo el
  // instante (salvo seguidores por día de la cuenta propia), así que "cuánto
  // creció esta semana" solo existe si alguien guardó cuánto había antes.
  //
  // Se escribe desde dos lados: cada lectura real del análisis (no de caché)
  // hace upsert de la fila de HOY, y un cron diario lee todas las cuentas
  // guardadas para que la serie no dependa de que alguien abra el dashboard.
  // Una fila por (usuario, fecha): la última lectura del día gana.
  id                    String   @id @default(cuid())
  // El handle normalizado, igual que MarketingAccount.usuario. Sin FK a
  // propósito: si un socio quita la cuenta y la vuelve a agregar, su histórico
  // sigue ahí, que es lo que se quiere.
  usuario               String
  // El día (fecha civil en hora RD) al que pertenece la lectura. DATE, no
  // timestamp: la unicidad es por día, y comparar timestamps con truncado
  // en cada consulta es la clase de cosa que se hace mal una vez.
  fecha                 DateTime @db.Date
  leidoEn               DateTime
  seguidores            Int
  seguidos              Int
  publicacionesTotales  Int
  // Del resumen de las últimas piezas leídas ese día. Redondeados como en el
  // análisis (1 decimal; la tasa 2).
  interaccionesPromedio Float
  likesMediana          Float
  tasaEngagementPct     Float?
  // Solo la cuenta propia: los totales de insights (28 días) tal cual vinieron,
  // para poder graficar alcance o guardados por día sin otra migración. Null
  // para terceros o si no llegaron.
  insights              Json?

  @@unique([usuario, fecha])
  @@index([usuario, fecha(sort: Desc)])
}

model TiktokCredential {
  // Singleton (id=1). El refresh token VIGENTE de la cuenta de TikTok de
  // FinZen (2026-09-18): TikTok puede devolver uno nuevo en cada renovación y
  // el anterior deja de valer, así que no puede vivir solo en una variable de
  // entorno que nadie actualiza. TIKTOK_REFRESH_TOKEN siembra la primera fila;
  // después manda esta tabla.
  id               Int       @id @default(1)
  refreshToken     String
  accessToken      String?
  accessExpiresAt  DateTime?
  refreshExpiresAt DateTime?
  openId           String?
  updatedAt        DateTime  @updatedAt
}

model TiktokSnapshot {
  // Una lectura por día de la cuenta de TikTok (misma idea que
  // InstagramSnapshot). Tabla aparte y no una genérica: las métricas que vale
  // la pena guardar no son las mismas (acá views y compartidos por video;
  // allá guardados y alcance).
  id                    String   @id @default(cuid())
  usuario               String
  fecha                 DateTime @db.Date
  leidoEn               DateTime
  seguidores            Int
  seguidos              Int
  likesTotales          Int
  videosTotales         Int
  viewsMediana          Float
  interaccionesPromedio Float
  tasaEngagementPct     Float?

  @@unique([usuario, fecha])
  @@index([usuario, fecha(sort: Desc)])
}

model MarketingLink {
  // Enlaces de referencia del apartado de Marketing (2026-09-17): Business
  // Manager, Ads Manager, página de Facebook, landing, tiendas. Kaizen NO los
  // lee; son accesos rápidos para el socio. Una fila por clave, y no una
  // columna por enlace en un singleton: agregar un enlace nuevo es agregarlo
  // a la lista del frontend, sin migración.
  clave     String   @id
  url       String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model DailyCampaignConfig {
  // Singleton (id=1). La campaña diaria (2026-09-20): una vez al día, a la
  // hora elegida, Kaizen propone UNA campaña en la conversación elegida, con
  // una audiencia distinta cada día. La tarjeta se confirma o rechaza desde
  // ese chat, con el mismo gate de siempre. Apagada por defecto.
  id             Int      @id @default(1)
  enabled        Boolean  @default(false)
  cronHour       Int      @default(9) // 0-23, hora de República Dominicana
  // Cómo se entrega: 'tarjeta' (la propuesta espera Confirmar/Rechazar en el
  // chat) o 'directo' (el job confirma en código y crea el borrador en FinZen,
  // donde un humano lo aprueba en el panel). 'directo' es una decisión de
  // ADMIN tomada desde Configuración; el modelo nunca la elige.
  modo           String   @default("tarjeta")
  // La conversación donde cae la tarjeta. Nullable: si el socio la borra, la
  // corrida se omite avisando, no crea una conversación por su cuenta.
  conversationId String?
  // Cuántos días sin repetir un segmento. 7 con un catálogo de 11 alcanza.
  rotacionDias   Int      @default(7)
  updatedAt      DateTime @updatedAt
  updatedBy      String?
}

model WeeklySummaryConfig {
  // Singleton (siempre id=1) — DISENO_FASE1.md §12 addendum, 2026-07-22.
  // Define QUÉ semana reporta el resumen y CUÁNDO corre. Son dos cosas
  // independientes: se puede correr el lunes reportando miércoles→martes.
  id           Int      @id @default(1)
  weekMode     String   @default("calendar") // 'rolling' | 'calendar' — mismo concepto que get_kpis(week_mode), PRD §4.2
  weekStartDay Int      @default(1) // 0=domingo..6=sábado; qué semana se REPORTA (solo aplica si weekMode='calendar')
  // Cuándo CORRE el cron. Configurable desde la web (2026-08-11); antes era la
  // constante '0 12 * * 1' del código. La hora es local de RD, no UTC.
  cronDay      Int      @default(1) // 0=domingo..6=sábado
  cronHour     Int      @default(8) // 0-23, hora de República Dominicana
  updatedAt    DateTime @updatedAt
  updatedBy    String? // partnerId de quien lo cambió por última vez (null = nunca configurado a mano)
}

model AdProposal {
  // Una campaña de Meta Ads propuesta por Kaizen (2026-10-04): promocionar un
  // post de Instagram de FinZen. Tabla propia y no una fila más de Proposal:
  // Proposal.payload es un CampaignDraftInput de FinZen y create_campaign_draft
  // lo lee tal cual; mezclar las dos cosas en una tabla es invitar a que un
  // borrador de push se arme con el payload de un anuncio.
  //
  // PROPOSED → CONFIRMED → CREATING → CREATED_PAUSED
  //          ↘ REJECTED · SUPERSEDED (otra tarjeta más nueva) · EXPIRED
  //            CREATING → ERROR (Meta rechazó un paso; lo creado quedó EN PAUSA)
  //
  // Lo que el MODELO elige: el post (mediaId), el nombre corto, el racional y
  // qué se va a medir. Lo que NO elige, porque sale de la configuración en el
  // momento de proponer: presupuesto, duración, objetivo, destino y
  // segmentación. El modelo no tiene dónde escribir un presupuesto.
  id                String        @id @default(cuid())
  conversationId    String?
  conversation      Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  status            String        @default("PROPOSED")
  // 'chat' (Kaizen la propuso conversando) o 'programada' (la corrida de la
  // publicidad automática). Las programadas son del negocio: cualquiera con
  // publicidad:confirmar las decide, también desde Auditoría.
  origen            String        @default("chat")
  // El post de Instagram de FinZen que se promociona, verificado en código
  // contra las publicaciones reales de la cuenta propia al proponer.
  mediaId           String
  mediaPermalink    String
  mediaTipo         String?
  mediaCaption      String? // inicio del caption, para la tarjeta
  // kaizen-ig-AAAAMMDD-<slug>. Es también el utm_campaign del destino: así el
  // gasto de Meta y la adquisición de FinZen unen por nombre sin adivinar.
  nombre            String
  objetivo          String // OUTCOME_TRAFFIC | OUTCOME_ENGAGEMENT | OUTCOME_AWARENESS
  urlDestino        String? // con los UTM ya puestos; null si el objetivo no lleva link
  presupuestoDiario Float // en la moneda de la cuenta (hoy el tope exige USD)
  moneda            String        @default("USD")
  duracionDias      Int
  segmentacion      Json // { paises, edadMin, edadMax, categoriaFinanciera }
  racional          String
  medicion          String
  // Lo que Meta devolvió al crear, paso a paso. Si un paso falla, los
  // anteriores quedan acá: todo nace en PAUSA, así que no gasta, pero un
  // humano tiene que borrarlo en Ads Manager.
  metaCampaignId    String?
  metaAdSetId       String?
  metaCreativeId    String?
  metaAdId          String?
  inicio            DateTime?
  fin               DateTime?
  error             String?
  confirmedAt       DateTime?
  confirmedBy       String? // partnerId — SOLO lo escribe el endpoint HTTP
  createdAt         DateTime      @default(now())

  @@index([conversationId, status])
  @@index([status, createdAt])
  @@index([mediaId])
}

model MetaAdsConfig {
  // Singleton (id=1). La publicidad automática (2026-10-04): los días y a la
  // hora elegidos, Kaizen elige un post de Instagram de FinZen y propone
  // promocionarlo, con la tarjeta en la conversación elegida. Al confirmar,
  // el CÓDIGO crea campaña, conjunto, creativo y anuncio EN PAUSA; un humano
  // la activa en Ads Manager. Apagada por defecto.
  id                  Int      @id @default(1)
  enabled             Boolean  @default(false)
  // Días de la semana en que corre: 0 = domingo … 6 = sábado (como cron).
  diasSemana          Int[]    @default([1])
  cronHour            Int      @default(9) // hora de RD
  conversationId      String?
  // Presupuesto DIARIO de cada campaña, en la moneda de la cuenta. El tope
  // duro sigue siendo META_MAX_DAILY_BUDGET_USD: esto no puede superarlo.
  presupuestoDiario   Float    @default(5)
  duracionDias        Int      @default(7)
  objetivo            String   @default("OUTCOME_TRAFFIC")
  // A dónde lleva el anuncio (la landing). Obligatorio con OUTCOME_TRAFFIC.
  urlDestino          String?
  paises              String[] @default(["DO"])
  edadMin             Int      @default(18)
  edadMax             Int      @default(65)
  // Categoría especial de Meta "productos y servicios financieros". Si
  // FinZen debe declararla, Meta limita la segmentación (edad 18-65, sin
  // segmentación fina) y el código lo respeta.
  categoriaFinanciera Boolean  @default(false)
  // Cuántos días sin volver a promocionar el mismo post.
  rotacionDias        Int      @default(30)
  updatedAt           DateTime @updatedAt
  updatedBy           String?
}
